# ─── Server ────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ────────────────────────────────────────────────────
# Option A: MongoDB Atlas (cloud) — free M0 cluster at https://cloud.mongodb.com
#   ⚠️  Make sure your IP is whitelisted in Atlas → Network Access
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/ai-debate-partner?appName=Cluster0

# Option B: Local MongoDB (no network issues)
#   Install from https://www.mongodb.com/try/download/community then use:
# MONGODB_URI=mongodb://localhost:27017/ai-debate-partner

# ─── JWT ────────────────────────────────────────────────────────
# Use a long random string — never expose this
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ─── Google Gemini AI ───────────────────────────────────────────
# Free tier available at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Hugging Face ───────────────────────────────────────────────
# Free token at https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_your_token_here

# ─── Cloudinary (optional — only needed for avatar uploads) ─────
# Free tier at https://cloudinary.com
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_CLOUD_NAME=your_cloud_name

# ─── Frontend ───────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
